;(function(){
/* The corruption, as a physical event.

   A tear is real absence: the canvas, its frame and the wall behind it all
   stop existing inside one outline, so the camera looks *into* the break rather
   than at a picture of one. The outline is a strike — a leader that kinks down
   the whole picture and forks, and forks again, on a bearing it chose for
   itself, and the channel does not stop at the bolt's own width: it gapes into
   lobes, fat pockets where the canvas let go and pinched nodes where it held.
   Two leaders cross, which is what makes the wound huge without one channel
   having to be a river.
   What hangs behind it is not a copy of the picture. It is a galaxy, and the
   galaxy's stars sit where the *picture* is bright, so the subject is continued
   rather than repeated: the same halos, the same moon, the same lit windows,
   re-formed as a constellation inside the mouth. Beyond the wall there is
   nothing at all: a matte black plate, deep in the structure, is the floor of
   the void, and the black between the stars is the thing that makes it a void.

   The break is never idle and never frantic: it re-cuts on one slow, steady
   beat, once every four seconds — slow enough that the wall label stays the
   thing worth looking at. A cut does not redraw the tear. The wound belongs to
   the picture — its bearing, the path of each channel, where the forks hang —
   and what a cut changes is its edge: how far the mouth swells and how far each
   fork runs, walked through seven fixed states, while the whole mass works a
   few centimetres further along the direction it was already torn in. So the
   break frays and travels like something under tension instead of rolling a new
   silhouette at a new angle every four seconds. Nothing interpolates — a glitch
   changes state, it does not travel.

   On top of that beat the break flinches: one or two spasms of about six frames
   in a window, during which the sky shifts whole bands of its grid up or down
   and the light drops out at whole-frame boundaries. Nothing gets brighter — a
   spasm is a misfire of position and presence, never of intensity. The edge of
   the absence keeps its own rate, so the tear never twitches its shape between
   cuts.

   One hue, at the levels the palette round settled: the arms and the deep field
   take the work's bleed, every point of light and both lobes of the rim take its
   tint, and nothing is mixed toward white.

   One silhouette function, compiled into two places: the discard test patched
   into the scene's own materials (which cuts the holes) and the additive quad
   hung in front of each picture (which draws the light). They share CHUNK, so
   the light always lands exactly on the edge of the absence. */
'use strict';

const MAX = 8;

/* How far out the silhouette can possibly reach, as a multiple of the radius.
   The cut, the void plate and the sky all have to cover at least this much, and
   if any one of them falls short the break gets clipped to a circle or loses its
   black backing. It is arithmetic, not taste: the furthest
   a fork can end is a fork origin's station (0.92 EXT), plus the longest fork
   with its own play, plus a sub-fork run out from seven tenths of that --
   304 + 222 + 155 cells -- and a channel's head is W0 * (0.72 + 0.85 * GAP *
   1.18) wide on top of that, which at the constants in CHUNK is 3.65 times the
   radius. Everything after that is measured on the picture's own plane, where
   the eye's ray crosses by definition (see tearProj), so the bevel the surfaces
   stand at no longer widens it and the cut's walk of a tenth of a radius lands
   on 3.75. It is one constant because the four uses have to agree -- and because
   the void plate is sized off it, so raising it grows a black slab that pokes
   past the wall panel it hides behind and reads as a hole in the room rather
   than in the picture. */
const COVER = 4.0;
/* What the shaders are handed rather than COVER itself: JS prints 4.0 as "4",
   and GLSL will not multiply a float by an untyped int, so a whole-number reach
   breaks every patched material in the room at once. */
const COVER_G = COVER.toFixed(2);

/* What to multiply a backing quad's reach by, for the depth it hangs at.
   The mouth is cut by the eye's ray, not by the wall's normal, so on a plane
   sitting d behind the picture it lands (D + d) / D wider than the silhouette
   that was drawn, where D is how far the visitor stands off it. The rig holds no
   picture at under about five metres, which puts the void floor at 85 cm back a
   sixth wider than the break it backs; without this the longest fork cuts clean
   through the edge of the black and the lit room shows behind the break.
   It is per-quad rather than folded into COVER because COVER also gates the
   shader's own cull, and that one is measured back on the picture's plane where
   no enlargement applies. */
const D_EYE = 5.0;
const pad = z => 1 + Math.max(0, -z) / D_EYE;

/* The break's edge light is drawn by the surfaces the break is cut in, at their
   own depth -- see tearEdge and tearCut. It used to be a quad floating in front
   of the wall, which could not work: the band slid sideways off the hole it
   edges by the quad's depth times how far the point sits from the camera's axis,
   so it was nil at the middle of the canvas and worst at a fork's tip, which is
   exactly where the eye goes, and no single depth was right everywhere because
   the canvas, the plaster and the moulding are three surfaces at three depths
   with three different holes. */

/* How far behind the picture plane the sky hangs. Behind the deepest surface
   the strike cuts, so that no hole can be wider than the sky seen through it. */
const SKY_Z = -0.25;

/* ------------------------------------------------------------- the palette

   Every break is lit in the colour of the picture it destroys, and in *one*
   colour: the duplicate's dots, the corona they bleed and both lobes of the
   neon on its edge all take their hue from `hue` on the work's own glitch entry
   and differ only in how much light they carry. Three separations round the
   wheel were tried and dropped in turn -- the corona opposite the plate, the
   edge's outer lobe a quarter turn back, and finally both a neighbour 25 degrees
   off -- and all three put a second colour on the tear, the last of them a
   violet-pink corona and rim on the deep blue Dalí (tools/n_dali), because a step
   from blue toward violet raises red fast. Nothing is mixed toward white either:
   a hue lifted for brightness is a hue diluted, and that is the wash the user's
   "make it clear" is about.

   What is *not* allowed to vary is how much light a break puts out. A
   saturated hue has low luminance -- a pure red carries a third of what white
   does -- so a tint that is merely multiplied would leave a red tear dim and a
   green one blazing. Each colour is therefore levelled to a luminance target,
   with a ceiling on the boost so a hue cannot drive its own peak past where the
   blown-out sheet started. The plate sits *under* the white it replaces rather
   than at it: at parity every lit cell crosses the bloom threshold, and the
   bloom that comes back over the field is white, which desaturates the whole
   screen back to the pale wash the hue was meant to replace (the first green
   Van Gogh, tools/hue3_vang). The shipped numbers below are the neutral case,
   and a work with no hue -- or a near-neutral one, like the Wanderer's white --
   keeps them exactly as they are. */
const LUM = [0.299, 0.587, 0.114];
const lumOf = c => c[0] * LUM[0] + c[1] * LUM[1] + c[2] * LUM[2];
const s2l = v => v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
const NEUTRAL = { tint: [1, 1, 1], bleed: [0.307, 0.278, 0.614],
                  rimA: [1.5, 0.05, 0.22], rimB: [0.05, 0.35, 1.6] };
/* the light each of the three slots is allowed to carry, taken off the shipped
   neutral so a coloured work cannot out-glow the one already approved. Dropping
   the plate to 0.72 to pull the pale cores of the green and the blue back under
   the bloom threshold barely moved them: a core is pale because that is where the
   picture itself is bright, not because the plate is loud. */
const AT = { tint: 0.85, bleed: lumOf(NEUTRAL.bleed),
             rimA: lumOf(NEUTRAL.rimA), rimB: lumOf(NEUTRAL.rimB) };
/* the ceiling on any one channel. A hue whose luminance weight is tiny needs an
   enormous number in that channel to reach the plate's target -- a deep royal
   blue carries 0.114 of the three weights, so parity asks for B = 7.4 -- and the
   tone curve is what makes that the wrong answer: a channel that far above 1 is
   crushed toward white while the hue's smaller channels ride the near-linear
   part of the curve, so chasing luma parity is precisely how a deep blue turns
   into a pale sky. The cap keeps a deep hue deep and lets it give up brightness
   it could never have shown as colour. Widening it (2.2 -> 3.2 -> 4.2) was tried
   on the strength of the Dalí reading dimmer than the green, and the dimness was
   the lesser of the two faults: the plate went azure, then white. */
const PEAK = 4.2;

function scaleTo(c, target) {
  const k = Math.min(target / Math.max(lumOf(c), 1e-4),
                     PEAK / Math.max(c[0], c[1], c[2], 1e-4));
  return [c[0] * k, c[1] * k, c[2] * k];
}

/** The colours one work corrupts in: its own hue, at the four levels the plate,
    the corona and the two lobes of its edge light each carry. Nothing here is a
    second hue -- see the note above on the neighbour that was tried and dropped. */
function palette(hex) {
  if (hex === undefined) return NEUTRAL;
  const c = new THREE.Color().setRGB(s2l(((hex >> 16) & 255) / 255),
                                     s2l(((hex >> 8) & 255) / 255),
                                     s2l((hex & 255) / 255),
                                     THREE.LinearSRGBColorSpace);
  const h = { h: 0, s: 0, l: 0 };
  c.getHSL(h, THREE.LinearSRGBColorSpace);
  /* a hue with no saturation has nothing to give the lights, so a neutral work
     keeps the red and violet pair it shipped with rather than going colourless */
  if (h.s < 0.12) return NEUTRAL;
  const own = [c.r, c.g, c.b];
  return { tint: scaleTo(own, AT.tint), bleed: scaleTo(own, AT.bleed),
           rimA: scaleTo(own, AT.rimA), rimB: scaleTo(own, AT.rimB) };
}

const v3 = a => new THREE.Vector3(a[0], a[1], a[2]);

/* --------------------------------------------------------- the silhouette */

const CHUNK = `
#define TAU 6.2831853
#define TEARPI 3.14159265
/* The break is drawn on a grid this fine, as a fraction of its own radius, so
   every width below is in cells of that grid: at the Starry Night's radius one
   cell is three millimetres of canvas, and a channel thirty four cells across
   is a wound you can read from the far side of the gallery. */
#define CELL 0.005

/* --------------------------------------------------------------- the strike

   One silhouette, and it is a bolt. NBOLT leaders run the field on their own
   bearings, each from -EXT to +EXT cells straight through the break's centre,
   so a strike always crosses the whole picture and leaves it at both edges.
   W0 is a channel's half width at its head and JAG how far the path may kick
   off its own axis; NFORK forks hang off a leader and NSUB of those fork again,
   which is where the branching read comes from. FLLEN is the longest fork. */
#define NBOLT 2
#define EXT 330.0
#define W0 24.0
#define JAG 2.4
#define NFORK 9
#define NSUB 4
#define FLLEN 150.0
/* A bolt-wide hole is a ribbon, and a ribbon cannot show what hangs behind it,
   so the wound does not stop at the bolt: it gapes. GAP is how far the channel
   swells past its own width and LOBES how many times along its length; the
   swell is fat pockets with pinched nodes between them, the way a tear opens
   where the canvas let go and holds where it did not. The gape is width, never
   path, so opening the mouth does not bend the strike. FGAP does the same for
   the forks, less, because a fork is a rip and not a mouth. */
#define GAP 1.3
#define LOBES 2.0
#define FGAP 0.7
#define FLOBES 2.0
/* How wide the break's own edge light is, in cells. It used to be a fraction of
   the comb's pitch, which was the distance between hairlines; a strike has no
   pitch, and its edge wants a band of its own. Three cells is a centimetre of
   canvas, which at the mouth of a wound is a lit edge; anything wider and the
   two sides of a fork meet in the middle and the break becomes a green outline
   drawn over the picture instead of a hole in it. */
#define RIMW 1.7

uniform mat4 uTearM[${MAX}];   /* world -> picture plane, in metres */
uniform vec2 uTearP[${MAX}];   /* radius, the break's own structure seed */
uniform vec2 uTearC[${MAX}];   /* where the break starts, in picture coords */
uniform int uTearCount;
/* Which of the seven edge states the room is in right now. One scalar for the
   whole scene, because every break re-cuts on the same beat. It is the only
   thing a cut changes: the strike's structure -- its bearing, its path, where
   its forks leave and which way they run -- belongs to uTearP.y and never
   moves, so a cut frays the same wound wider or narrower and lets its forks
   reach further or fall short, instead of rolling a new bolt at a new angle.
   Set back to 0 by tick when the room is frozen. */
uniform float uCut;
/* What the break's edge costs the surface it is cut in: the work's own colour
   at the lip and a hair behind it, and how hard it is lit this frame. Per break
   because per break is how the colour works -- one hue per picture, four levels.
   The edge light used to be a quad floating in front of the wall, and a flat
   quad cannot register with a cone: it lined up with the canvas and landed on
   sound plaster outside the hole in the wall, a pale contour drawn round every
   shard. These are what let the light be drawn by the surfaces themselves, at
   their own depth, on their own edge. */
uniform vec3 uRimA[${MAX}];
uniform vec3 uRimB[${MAX}];
uniform vec2 uLit[${MAX}];     /* x: gain, y: jitter */

float tearHash(float n) { return fract(sin(n * 12.9898) * 43758.5453); }

/* Value noise interpolated linearly, so the bends are corners. A leader steps:
   it runs straight, kinks, runs straight again. Smoothed noise here would draw
   a wave, and a wave is not a strike. */
float tearKink(float x, float s, float sp, float amp) {
  float i = floor(x / sp), f = x / sp - i;
  float a = tearHash(i * 7.13 + s), b = tearHash((i + 1.0) * 7.13 + s);
  return (a + (b - a) * f - 0.5) * 2.0 * amp;
}

/* One channel, from o along u, L cells long, tapering to a point. The distance
   is exact because the sample is taken in the channel's own frame, which is
   what lets a fork leave at any angle and still light its edge correctly.
   The path's offset is damped by t toward the tail, so a channel straightens
   as it dies out rather than thrashing at its own tip.
   sp is the channel's structure seed and wsd its fray seed: the path is read
   from sp and the ragged width from wsd, which is the whole split between the
   wound and its edge. */
float tearChan(vec2 P, vec2 o, vec2 u, vec2 v, float L, float w0, float sp,
               float jag, float gap, float lobe, float wsd) {
  float la = dot(P - o, u);
  if (la < 0.0 || la > L) return 1e9;
  float lp = dot(P - o, v);
  float t = 1.0 - la / L;
  float path = tearKink(la, sp, L / 5.0, w0 * jag) +
               tearKink(la, sp + 5.3, L / 14.0, w0 * jag * 0.45);
  /* 0.72 to 1.48, not 0.42 to 1.77. The wider ratio pinched the channel nearly
     shut between every swell, and a rope of fat beads is a scallop: at the mouth
     the strike stopped reading as a line that tore. The narrow one keeps the
     swell and the pinch, which is what a rip does, without ever closing.
     A triangle, not a sine: a tear pinches at a corner. Rounded swells read as
     something melted, and the whole point of the gape is that the canvas let go
     along a line and the hole opened either side of where it held. */
  float gz = gap > 0.0 ? 0.72 + 0.85 * gap *
               (1.0 - abs(fract(la / lobe) * 2.0 - 1.0)) : 1.0;
  /* Continuous, and coarse. A width hashed per few cells steps the edge in
     squares, and squares on a smooth boundary read as stair-stepping rather
     than as torn: the same linear-interp noise the path uses, at an eighth of
     its amplitude and a quarter of its wavelength. */
  float w = max(1.5, w0 * (0.28 + 0.72 * t) * gz *
                     (1.0 + 0.17 * tearKink(la, wsd * 3.1 + 11.0, 21.0, 1.0)));
  return max(abs(lp - path * t) - w, max(-la, la - L) - 1.0);
}

/* One bolt: the leader, its forks, and their own.
   A fork starts on its parent's path at the station where the parent actually
   is, in the parent's own across axis, not on the axis the parent was drawn
   along. Taking the offset on the wrong side of it put every fork a hand's
   width off the bolt it hung from. */
float tearBolt(vec2 P, float st, float sd, float th, float so) {
  vec2 u = vec2(cos(th), sin(th)), v = vec2(-sin(th), cos(th));
  vec2 o = -u * EXT;
  /* What a cut is allowed to do: swell the mouth and run the forks a little
     further or a little shorter. Never the bearing, never the path, never where
     the forks hang. Those are the wound, and the wound is the thing the viewer
     has been reading for the last four seconds. */
  float breathe = 0.82 + 0.36 * tearHash(sd * 2.7 + so);
  float d = tearChan(P, o, u, v, EXT * 2.0, W0, st + so, JAG,
                     GAP * breathe, EXT * 2.0 / (LOBES * 2.0), sd + so);
  for (int i = 0; i < NFORK; i++) {
    float s = float(i) + 1.7;
    /* measured along the leader from its own start, so a fork can hang off any
       station of it. Taking the station as a signed distance from the centre
       instead put every fork in the near half of the bolt and left the far half
       forking at nothing. */
    float at = EXT + (tearHash(s * 3.1 + st * 2.3 + so) * 2.0 - 1.0) * EXT * 0.92;
    /* the parent's centre at that station, damped exactly as the parent damps
       it. Anything less and the fork leaves the bolt a hand's width to one side
       of the bolt, which reads as a second wound rather than a branch. */
    float pt = 1.0 - at / (EXT * 2.0);
    float off = pt * (tearKink(at, st + so, EXT * 2.0 / 5.0, W0 * JAG) +
                      tearKink(at, st + so + 5.3, EXT * 2.0 / 14.0, W0 * JAG * 0.45));
    vec2 po = o + u * at + v * off;
    float side = tearHash(s * 5.7 + st + so) > 0.5 ? 1.0 : -1.0;
    float an = th + side * (0.62 + tearHash(s * 7.3 + st * 3.1 + so) * 0.75);
    vec2 fu = vec2(cos(an), sin(an)), fv = vec2(-sin(an), cos(an));
    float L = (45.0 + tearHash(s * 9.1 + st * 1.3 + so) * FLLEN) *
              (0.86 + 0.28 * tearHash(s * 4.7 + sd * 3.7 + so));
    d = min(d, tearChan(P, po, fu, fv, L, W0 * 0.3, st + s * 11.1, JAG,
                        FGAP * breathe, L / FLOBES, sd + s));
    if (i < NSUB) {
      float s2 = s + 20.3;
      float at2 = L * (0.35 + tearHash(s2 * 3.7 + st + so) * 0.5);
      float pt2 = 1.0 - at2 / L;
      float off2 = pt2 * (tearKink(at2, st + s * 11.1, L / 5.0, W0 * 0.3 * JAG) +
                          tearKink(at2, st + s * 11.1 + 5.3, L / 14.0,
                                   W0 * 0.3 * JAG * 0.45));
      vec2 bo = po + fu * at2 + fv * off2;
      float an2 = an - side * (0.5 + tearHash(s2 * 5.1 + st * 2.7) * 0.8);
      vec2 gu = vec2(cos(an2), sin(an2)), gv = vec2(-sin(an2), cos(an2));
      d = min(d, tearChan(P, bo, gu, gv,
                          L * (0.3 + tearHash(s2 * 7.7 + st) * 0.4),
                          W0 * 0.16, st + s2 * 13.3, JAG * 1.35,
                          FGAP * 0.6 * breathe, L / 1.8, sd + s2));
    }
  }
  return d;
}

/* The break's bearing, and the only form of it anyone else needs: tick() walks
   the cut along this axis, so the JS copy below and the GLSL one have to agree.
   It is continuous rather than snapped to one of four directions the way the
   combed mass was -- a strike chose its own line, and quantising it to a
   compass rose is what made the old tear look drawn with a ruler. */
float tearBearing(float st) { return tearHash(7.3 + st * 1.7) * 1.5 - 0.75; }

float tearField(vec2 p, float R, float st) {
  float sd = st + uCut * 13.79;
  float g = R * CELL;
  vec2 P = p / g;
  float th0 = tearBearing(st);
  float d = 1e9;
  for (int b = 0; b < NBOLT; b++) {
    float k = float(b);
    /* the second bolt crosses the first rather than paralleling it, which is
       the read of two strikes in one place; the third is held in reserve */
    float th = k < 0.5 ? th0 : (k < 1.5 ? -th0 * 1.35 + 0.62 : th0 + 1.9);
    d = min(d, tearBolt(P, st, sd, th, k * 91.7));
  }
  return d * g;
}

/* Where the ray from the eye through a point on a surface at depth z crosses
   the picture's own plane. Every surface the break is cut in is asked about at
   *this* point rather than at its own, so all of them open to one shape on the
   screen however far apart they stand, and the break reads as an absence you
   look straight through.
   A silhouette fixed in the picture's plane cannot do that. The canvas hangs
   3 cm off the panel back and the frame's outer band stands 13 cm proud of it,
   so a hole of one size projects wider the nearer it is, and anywhere off the
   eye's axis the front surface's hole overruns the one behind it. What shows in
   the ring between the two is sound wall -- a pale contour the width of that
   overrun, nil where the break crosses the middle of the canvas and fattest at a
   fork's tip, which is where the eye lands. No scaling by depth alone can
   follow it, because the overrun is a function of the viewing angle: the same
   two surfaces part company as the visitor walks past them. */
vec2 tearProj(mat4 m, vec2 xy, float z) {
  vec3 c = (m * vec4(cameraPosition, 1.0)).xyz;
  float du = z - c.z;
  if (abs(du) < 1e-4) return xy; /* eye-on: the surface is edge-on and unseeable */
  float t = -c.z / du;
  return c.xy + (xy - c.xy) * t;
}

/* The lit edge, on the lip of the wound and not inside it: two lobes running
   out from d = 0 into the material that is still there, the work's colour at
   the boundary and the same hue a hair behind it. The mirror of the old band,
   which sat inside the mouth -- and inside the mouth there is nothing left to
   paint, which is why that light had to be a separate quad, and why a flat quad
   can never register with holes cut at three different depths.
   The width is RIMW cells rather than metres so it scales with the break: a
   band fixed in metres is invisible on a small tear or wider than the channel
   on a big one. It is 0.30 and not the 0.42 the floating quad carried: on the
   surface the band stops being a line in air and becomes the brightest thing in
   a dark region, which is exactly what the bloom pass picks up and smears, and
   the smear is wider than the edge it came from. */
vec3 tearEdge(float d, float w, float jit, vec3 a, vec3 b) {
  if (d < 0.0) return vec3(0.0);
  w *= 1.0 + jit;
  float hw = w * 0.42;
  float gA = exp(-pow((d - w * 0.16) / hw, 2.0));
  float gB = exp(-pow((d - w * 1.05) / hw, 2.0));
  return a * gA + b * gB;
}
`;

/* The cut itself. The silhouette is measured where the eye's ray through the
   fragment crosses the picture's plane -- see tearProj -- so one break, cut in
   five surfaces at five depths, has one shape on the screen.
   The slab test is what keeps the break where the picture hangs: a tear is an
   absence in the canvas and in the wall directly behind it, not a field that
   the far side of the room also has to stand.
   The cut is the strike itself, and everything the camera sees through it is
   the sky hanging behind the canvas. */
const CUT = `
void tearCut(vec3 wp, out vec3 glow) {
  glow = vec3(0.0);
  for (int i = 0; i < ${MAX}; i++) {
    if (i >= uTearCount) break;
    vec3 q = (uTearM[i] * vec4(wp, 1.0)).xyz;
    if (q.z < -0.62 || q.z > 0.40) continue;
    float R = uTearP[i].x;
    vec2 d = tearProj(uTearM[i], q.xy, q.z) - uTearC[i];
    if (length(d) > R * ${COVER_G}) continue;
    float s = tearField(d, R, uTearP[i].y);
    if (s < 0.0) discard;
    /* the same distance the cut was decided from, at the same depth, on the
       surface that survived it: this edge cannot come unglued from its hole,
       because it is the same test on the same point */
    glow += tearEdge(s, R * CELL * RIMW, uLit[i].y, uRimA[i], uRimB[i]) *
            (0.30 * uLit[i].x);
  }
}
`;

const uniforms = {
  uTearM: { value: Array.from({ length: MAX }, () => new THREE.Matrix4()) },
  uTearP: { value: Array.from({ length: MAX }, () => new THREE.Vector2(0, 0)) },
  uTearC: { value: Array.from({ length: MAX }, () => new THREE.Vector2(0, 0)) },
  uTearCount: { value: 0 },
  /* shared by every patched material and every sky, so one write per
     frame re-cuts the whole room at once */
  uCut: { value: 0 },
  /* per break, because the colour is per break: the work's own hue at the two
     levels its edge carries, and how hard that edge is lit this frame */
  uRimA: { value: Array.from({ length: MAX }, () => new THREE.Vector3()) },
  uRimB: { value: Array.from({ length: MAX }, () => new THREE.Vector3()) },
  uLit: { value: Array.from({ length: MAX }, () => new THREE.Vector2(1, 0)) }
};

/* the shape each break returns to, and the sky that hangs behind it */
const base = [];
const ghosts = [];

/** Register one picture's break. Call once the group is where it hangs. */
function register(group, e) {
  const i = uniforms.uTearCount.value;
  if (i >= MAX) return;
  group.updateWorldMatrix(true, false);
  const m = new THREE.Matrix4().copy(group.matrixWorld).invert();
  uniforms.uTearM.value[i].copy(m);
  uniforms.uTearP.value[i].set(radius(e), seed(e));
  const o = e.glitch || {};
  uniforms.uTearC.value[i].set(o.cx || 0, o.cy || 0);
  const pal = palette(o.hue);
  uniforms.uRimA.value[i].copy(v3(pal.rimA));
  uniforms.uRimB.value[i].copy(v3(pal.rimB));
  base[i] = { r: radius(e), sd: seed(e), cx: o.cx || 0, cy: o.cy || 0,
              /* the bearing the strike fell in, and the positions the cut walks
                 between along it. This is the shader's tearBearing, so the two
                 have to be the same arithmetic. */
              th: rnd(7.3 + seed(e) * 1.7) * 1.5 - 0.75 };
  ghosts[i] = e._ghost;
  uniforms.uTearCount.value = i + 1;
}

function radius(e) {
  const o = e.glitch || {};
  /* the base is what the star used; the field on top of it is what changed, so
     the break reads as a burst of joined bars rather than a scaled-up spike */
  return o.radius === undefined ? (e.w + e.h) * 0.235 : o.radius;
}
function seed(e) { return ((e.seed || 1) % 997) * 0.137; }

/* ------------------------------------------------- patching scene materials */

const patched = new WeakSet();

/** Give an existing material the cut. The tear field is global, so one patch
    serves every break: the wall, the moulding and the canvas all go. */
function patch(mat) {
  if (!mat || patched.has(mat)) return mat;
  patched.add(mat);
  /* without this three would hand the program to unpatched twins */
  mat.customProgramCacheKey = () => 'tear';
  mat.onBeforeCompile = (shader) => {
    Object.assign(shader.uniforms, uniforms);
    shader.vertexShader = 'varying vec3 vTearW;\n' + shader.vertexShader.replace(
      '#include <project_vertex>',
      'vTearW = ( modelMatrix * vec4( transformed, 1.0 ) ).xyz;\n#include <project_vertex>');
    shader.fragmentShader = 'varying vec3 vTearW;\n' + CHUNK + CUT +
      shader.fragmentShader
        .replace('#include <clipping_planes_fragment>',
          '#include <clipping_planes_fragment>\n\tvec3 tearGlow; tearCut( vTearW, tearGlow );')
        /* added before the surface's own tone mapping, so the edge light is
           treated exactly as an emissive term is: it is not lit by the gallery,
           it makes its own light, and it rolls off with everything else */
        .replace('#include <tonemapping_fragment>',
          'gl_FragColor.rgb += tearGlow;\n#include <tonemapping_fragment>');
  };
  mat.needsUpdate = true;
  return mat;
}

/* ------------------------------------------------------- the bitmap ghost */

const DOT = '#e6e2d8';
const GROUND = '#050506';

/** A picture reduced to an Atkinson dither — the 1-bit bitmap the early Mac drew
    its screen with. Returns the cell grid, not a picture: which cells are ink and
    the tone each was quantised from.
    Before quantising, the luminance is stretched to the picture's own black and
    white points and given one gentle unsharp pass, which is what separates a
    figure from its background once the detail is gone.
    `sd` is the work's seed: it throws the corruption described below, so a
    painting keeps its damage between visits to the room. */
function atkinsonCells(src, cells, sd) {
  const cols = Math.max(16, Math.round(cells));
  const rows = Math.max(12, Math.round(cols * src.height / src.width));
  const small = document.createElement('canvas');
  small.width = cols; small.height = rows;
  const sctx = small.getContext('2d', { willReadFrequently: true });
  sctx.drawImage(src, 0, 0, cols, rows);
  const d = sctx.getImageData(0, 0, cols, rows).data;

  const n = cols * rows;
  const raw = new Float32Array(n);
  for (let i = 0; i < n; i++) {
    const k = i * 4;
    raw[i] = (d[k] * 0.299 + d[k + 1] * 0.587 + d[k + 2] * 0.114) / 255;
  }

  /* the picture's real black and white points, ignoring its extreme outliers */
  const sorted = Float32Array.from(raw).sort();
  const at = q => sorted[Math.min(n - 1, Math.floor(q * n))];
  const lo = at(0.03);
  const hi = Math.max(at(0.97), lo + 0.14);
  const tone = new Float32Array(n);
  for (let i = 0; i < n; i++) {
    let v = (raw[i] - lo) / (hi - lo);
    v = v < 0 ? 0 : v > 1 ? 1 : v;
    /* held down below the line: a printed screen keeps its black between the
       dots, and the passages that go solid are the ones that were white */
    tone[i] = Math.pow(v, 1.35);
  }

  /* one unsharp pass on the stretched tone, before any of it is quantised */
  const sharp = new Float32Array(n);
  const amt = 0.5;
  for (let y = 0; y < rows; y++) {
    for (let x = 0; x < cols; x++) {
      const i = y * cols + x;
      const l = tone[i - (x > 0)], r = tone[i + (x < cols - 1)];
      const u = tone[i - cols * (y > 0)], b = tone[i + cols * (y < rows - 1)];
      const blur = (l + r + u + b) * 0.25;
      let v = tone[i] + (tone[i] - blur) * amt;
      sharp[i] = v < 0 ? 0 : v > 1 ? 1 : v;
    }
  }

  /* Atkinson spreads six of the eight units of error forward and down and keeps
     the other two, so a cell only lights when its neighbourhood is genuinely
     bright: the darks stay solid black instead of turning into a fine screen,
     and the light runs out into a coarse, deliberate grain. */
  const a = Float32Array.from(sharp);
  const FWD = [[1, 0], [2, 0], [-1, 1], [0, 1], [1, 1], [0, 2]];
  for (let y = 0; y < rows; y++) {
    for (let x = 0; x < cols; x++) {
      const i = y * cols + x;
      const v = a[i] > 0.5 ? 1 : 0;
      const err = a[i] - v;
      a[i] = v;
      for (const [dx, dy] of FWD) {
        const nx = x + dx, ny = y + dy;
        if (nx >= 0 && nx < cols && ny < rows) a[ny * cols + nx] += err * 0.125;
      }
    }
  }

  /* The ghost is damaged the way a file is damaged, not the way paint is:
     whole scanline bands pulled sideways off the grid they belong to, a run of
     cells that dropped out, a run that fused solid, and stray flipped pixels.
     It is baked into the texture here so the corruption is a property of the
     duplicate and never an animation — a glitch's shape does not travel.
     Everything is thrown from the picture's own seed, so each work keeps the
     same damage every time the room is built. */
  const R = x => { const v = Math.sin(x * 91.77) * 41237.19; return v - Math.floor(v); };
  const sd0 = sd || 1;
  const bands = 3 + Math.floor(R(sd0) * 3);
  for (let b = 0; b < bands; b++) {
    const y0 = Math.floor(R(sd0 * 3.7 + b * 13.1) * (rows - 2));
    const bh = 1 + Math.floor(R(sd0 * 5.3 + b * 7.9) * 3);
    /* a whole number of cells, so a sheared band still lands on the grid */
    const dx = Math.round((R(sd0 * 7.1 + b * 2.3) - 0.5) *
                          2 * (3 + 22 * R(sd0 * 1.9 + b * 17.7)));
    for (let y = y0; y < Math.min(rows, y0 + bh); y++) {
      const row = a.slice(y * cols, y * cols + cols);
      for (let x = 0; x < cols; x++) {
        a[y * cols + x] = row[(((x - dx) % cols) + cols) % cols];
      }
    }
  }
  for (let k = 0; k < 2; k++) {
    const y = Math.floor(R(sd0 * 13.7 + k * 29.3) * rows);
    const x = Math.floor(R(sd0 * 17.3 + k * 31.1) * cols);
    const len = 4 + Math.floor(R(sd0 * 23.9 + k * 7.7) * 26);
    for (let j = 0; j < len; j++) a[y * cols + ((x + j) % cols)] = k ? 1 : 0;
  }
  const strays = Math.floor(n * 0.004);
  for (let j = 0; j < strays; j++) {
    const p = Math.floor(R(sd0 * 41.3 + j * 3.1) * n);
    a[p] = a[p] > 0.5 ? 0 : 1;
  }

  return { cols, rows, ink: a, tone: sharp };
}

/** The duplicate itself: that grid, painted. Light dots on a black ground, one
    square per cell, and no grey anywhere -- the tone is carried entirely by how
    thickly the lit cells are scattered.
    `invert` reverses the two at the bitmap level: the paper becomes the ground
    and the marks go dark, so the duplicate hangs as a negative of itself. */
function bitmapTexture(src, cells, invert, sd) {
  const g = atkinsonCells(src, cells, sd);
  const a = g.ink, cols = g.cols, rows = g.rows;
  const S = 4;
  const out = document.createElement('canvas');
  out.width = cols * S; out.height = rows * S;
  const ctx = out.getContext('2d');
  ctx.fillStyle = invert ? DOT : GROUND;
  ctx.fillRect(0, 0, out.width, out.height);
  ctx.fillStyle = invert ? GROUND : DOT;
  for (let i = 0; i < a.length; i++) {
    if (a[i] < 0.5) continue;
    ctx.fillRect((i % cols) * S, Math.floor(i / cols) * S, S, S);
  }
  const t = new THREE.CanvasTexture(out);
  t.colorSpace = THREE.SRGBColorSpace;
  t.anisotropy = 8;
  /* The grid itself, kept off the canvas it was drawn to. The constellation is
     built from these numbers and not from a second reading of the picture: the
     dither has already solved the one problem the sky has, which is how to say
     a tone with dots. `ink` is the damaged 1-bit field, `tone` the stretched,
     unsharpened value each cell was quantised from. */
  t.userData.cells = g;
  return t;
}

/* The sky needs its own vertex shader: it is the one surface in the room that
   has to know where it is in the world, because it exists only inside a break. */
const SKY_VERT = 'varying vec2 vUv; varying vec3 vW;' +
  ' void main(){ vUv = uv; vW = (modelMatrix * vec4(position, 1.0)).xyz;' +
  ' gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }';

/* What hangs behind the break is not a copy of the picture any more. It is a
   galaxy, and the galaxy's stars are placed where the *picture* is bright, so
   the subject is continued rather than repeated: the same halos, the same moon,
   the same lit windows, re-formed as a constellation inside the mouth.
   One hue at two levels, which is the rule the colour round left behind: the
   arms and the deep field are the work's bleed, every point of light is its
   tint, and nothing is mixed toward white. The black between them is the whole
   read -- a galaxy is a light in a void, and colouring the void is what turns
   it into a poster.
   A flinch moves this sky, it does not brighten it. uRoll drags whole bands of
   the constellation off the grid they belong to and uGain only ever asks 1 or 0,
   so the worst a spasm can do is take the sky away for a frame. */
const SKY_FRAG = CHUNK + `
varying vec3 vW;
uniform sampler2D uStar;   /* one cell per picture cell: R mag, G flare */
uniform vec2 uGrid;        /* how many cells across and down that is */
uniform vec2 uPlane;       /* the quad the sky is hung on, in metres */
uniform vec2 uPic;         /* and the picture it continues, so s is 0..1 on hers */
uniform float uAspect;     /* width over height, of the picture */
uniform float uSeed;
uniform vec3 uTint;        /* every point of light: the work's own hue */
uniform vec3 uBleed;       /* the arms and the deep field: the same hue, lower */
uniform float uGain;       /* the flinch: 1 is on, 0 is the sky dropped out */
uniform float uRoll;       /* this spasm's height, in cells; 0 is at rest */
uniform float uRollSeed;   /* fixes which bands move and which one goes dark */
uniform float uRollBands;  /* how many horizontal bands the roll cuts into it */
uniform vec2 uGc;          /* the galaxy's own centre, off the picture's */
uniform float uGz;         /* how far it is zoomed into the mouth */
uniform float uRot;
uniform float uArms;
uniform float uTwist;
uniform float uArmGain;
uniform float uStarGain;
varying vec2 vUv;

float skyHash(float n) { return fract(sin(n * 12.9898) * 43758.5453); }

/* A log spiral. The arms are a function of angle and of the logarithm of the
   radius, which is how they keep their spacing as they open out. The dust term
   has to stay coarser than the mouth it is seen through: at r * 26 it rang finer
   than the opening is wide, every arm arrived inside the rip as a stripe, and
   the galaxy read as a barber pole.

   The core is the hard part of a log spiral, because its pitch goes as 1 / r:
   wound honestly it rings up into an unresolvable stack of circles around a
   point of infinite brightness, and the mouth showed a target rather than a
   galaxy. Three things hold it down. The log is taken of (r + 0.55) and not of
   r, so the winding slows long before the centre is reached — at the old 0.30
   the arms were still thirteen pixels apart inside the mouth, which is a swirl,
   not a cloud. The arm term is faded out over that same scale, so what is left
   at the middle is the bulge and nothing else. And the disk's own 1/r brightening
   is capped at it — a bulge is a *fat* glow, and an uncapped one is a needle. */
float spiralArm(vec2 q, float arms, float twist) {
  float r = length(q) + 1e-4;
  float a = atan(q.y, q.x);
  float s = a + log(r + 0.55) * twist;
  float arm = (0.50 + 0.50 * pow(abs(sin(s * arms)), 0.8)) *
              smoothstep(0.0, 0.55, r);
  /* Cloud, not rings. A hard power on the arm band lays a set of concentric
     stripes across the mouth, which reads as a target; a nebula is the same
     spiral structure as light that pools and thins. So the arms ride on a broad
     base instead of rising out of nothing, the exponent is low enough for a band
     to have a soft shoulder, and one slow term billows the brightness along the
     arm and across it at unequal scales. The billow is deliberately the stronger
     of the two modulations: it is what breaks a stripe into a puff. */
  float billow = 0.60 + 0.40 * sin(s * 2.7 + 1.7) * cos(r * 4.1 - s * 0.8);
  /* Shallow, not steep: the mouth is wide, and a real spiral's fall off puts
     everything past its own body in the dark, so the strike opens onto a dot
     instead of a galaxy. Two is shallow enough that the arms are still dimly lit
     three units out, which is where the far pockets are, and steep enough that
     the tips go to nothing. */
  float disk = exp(-r / 2.0) / (0.35 + r * 2.4);
  float dust = 0.72 + 0.28 * sin(s * 5.0 + r * 7.0);
  /* The bulge is a fat glow, never a needle -- and at a tenth of a unit it was
     a point the tone curve crushed to white as soon as the mouth was wide
     enough to show it, which is the other half of the ringed look. It also has
     to sit *under* the arm peaks: a bulge brighter than the arms reads as a lamp
     with something wrapped around it, and the room showed exactly that. Two
     scales now, a tight core and a wide halo, because the arms are faded out at
     the centre and a single term leaves the middle of the cloud a white coin
     instead of the brightest part of a diffuse body. */
  return arm * disk * dust * billow +
         exp(-r / 0.55) * 0.26 + exp(-r / 1.7) * 0.22;
}

/* The deep background, thrown on a jittered grid and unrelated to the picture,
   so the void reads as space and not as a painted nebula. One cell in three
   holds anything, and a point is a pixel and a half across: wider and the field
   stops being stars and becomes a texture. */
float deepField(vec2 p, float pitch, float sd) {
  vec2 c = floor(p / pitch);
  vec2 f = p / pitch - c;
  float h = skyHash(c.x * 3.7 + c.y * 17.3 + sd);
  if (h > 0.30) return 0.0;
  vec2 j = vec2(skyHash(c.x * 9.1 + c.y * 3.3 + sd),
                skyHash(c.x * 5.7 + c.y * 11.7 + sd)) - 0.5;
  vec2 d = f - 0.5 - j * 0.7;
  float r2 = dot(d, d) / (0.05 + 0.18 * skyHash(c.x * 7.7 + c.y * 5.1 + sd));
  return exp(-r2 * 18.0) * (0.35 + 0.65 * skyHash(c.x * 13.1 + c.y * 7.9 + sd));
}

/* The picture continued. Which of its cells hold a node, how bright and whether
   they flare comes from the star map, which is the picture's own Atkinson dither
   read straight -- the same dot field the duplicate was inked with, so the sky
   and the picture cannot disagree about where the face is, and the tones of a
   wash land wherever error diffusion put the dots rather than wherever a
   threshold happened to fall. The point stays under a cell across so the black
   between stars survives; the four spikes are what make it big. */
float imageStars(vec2 s, float sd) {
  /* the constellation is the picture's, so it stops where the picture does. The
     sky goes on past that edge and the galaxy with it, but past the frame there
     is no subject left to continue. */
  if (s.x < 0.0 || s.y < 0.0 || s.x > 1.0 || s.y > 1.0) return 0.0;
  vec2 g = s * uGrid;
  vec2 cell = floor(g);
  float e = 0.0;
  for (int oy = -1; oy <= 1; oy++) {
    for (int ox = -1; ox <= 1; ox++) {
      vec2 c = cell + vec2(float(ox), float(oy));
      if (c.x < 0.0 || c.y < 0.0 || c.x >= uGrid.x || c.y >= uGrid.y) continue;
      vec3 t = texture2D(uStar, (c + 0.5) / uGrid).rgb;
      vec2 j = vec2(skyHash(c.x * 5.3 + c.y * 2.9 + sd),
                    skyHash(c.x * 7.1 + c.y * 4.7 + sd)) - 0.5;
      vec2 d = g - c - 0.5 - j * 0.5;
      float r2 = dot(d, d);
      /* Nearly constant across the grid: the point is the same size wherever it
         sits, because the dither has already spent its whole effort on saying
         where the stars are and how many of them there are. Only the level
         divides the ink from the paper. */
      float pt = exp(-r2 / (0.008 + 0.010 * t.r * t.r));
      float spike = (exp(-d.x * d.x / 0.16) + exp(-d.y * d.y / 0.16)) *
                    exp(-r2 * 2.2) * t.g;
      e += (pt + spike * 0.62) * (0.50 + 0.40 * t.r) * t.b;
    }
  }
  return e;
}

void main() {
  /* The sky is not a backdrop, it is the far side of this particular absence.
     The quad it hangs on is as wide as the whole break so that every hole the
     strike makes in the wall shows it, which means it has to cut itself to the
     same silhouette the wall is cut to: unclipped, a six-metre panel of space
     stands proud of the wall and the room fills with stars. */
  bool open = false;
  for (int i = 0; i < ${MAX}; i++) {
    if (i >= uTearCount) break;
    vec3 q = (uTearM[i] * vec4(vW, 1.0)).xyz;
    if (q.z < -0.62 || q.z > 0.40) continue;
    /* drawn 1.5% wider than the mouth it fills: the two tests agree on the
       silhouette but not on the antialiased pixel between them, and a hairline
       of bare void round the edge of the sky reads as a dark seam */
    vec2 d = (tearProj(uTearM[i], q.xy, q.z) - uTearC[i]) * 0.985;
    if (length(d) > uTearP[i].x * ${COVER_G}) continue;
    if (tearField(d, uTearP[i].x, uTearP[i].y) < 0.0) { open = true; break; }
  }
  if (!open) discard;
  /* the sky's own frame, top down, so it lands on the picture the way the
     picture is read: v runs up the plane and the grid runs down the canvas.
     The quad is wider than the canvas it carries, because the break is, so the
     picture's unit square is mapped out of the middle of it and runs past zero
     at both edges -- the galaxy continues where the paint has gone, and the
     constellation does not. */
  vec2 s = (vUv - 0.5) * (uPlane / uPic) + 0.5;
  s.y = 1.0 - s.y;
  float dark = 0.0;
  if (uRoll > 0.0) {
    float band = floor(s.y * uRollBands);
    float h = skyHash(band * 7.3 + uRollSeed * 12.7);
    if (h > 0.52) {
      float dir = h > 0.76 ? 1.0 : -1.0;
      float cells = uRoll * (1.0 + floor(skyHash(band * 3.1 + uRollSeed) * 2.0));
      s.y += dir * cells / uGrid.y;
    }
    dark = step(0.93, skyHash(band * 17.9 + uRollSeed * 5.3));
  }
  vec2 q = (s - 0.5 - uGc) * vec2(uAspect, 1.0) / uGz;
  float cs = cos(uRot), sn = sin(uRot);
  vec2 r = vec2(q.x * cs - q.y * sn, q.x * sn + q.y * cs);
  float deep = spiralArm(r, uArms, uTwist) * uArmGain +
               deepField(vec2(s.x * 1.6, s.y * 1.6 / uAspect), 0.03, uSeed) * 0.5;
  float st = imageStars(s, uSeed) * uStarGain;
  /* A nebula is one enormous shallow gradient, and a gradient that shallow does
     not survive eight bits: out in the far pockets, where the sky is only just
     lit, it stepped into bands you could count. One hash per fragment at about a
     code value breaks the stair and never shows as grain against the body. */
  float dth = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) *
                     43758.5453) - 0.5;
  gl_FragColor = vec4((deep * uBleed + st * uTint) * uGain * (1.0 - dark) +
                      dth * 0.004, 1.0);
}`;

/** The star map: one texel per cell of the picture's own grid, holding the
    node's magnitude in R, its flare in G and its level in B.
    The constellation's job is to *complete* the picture, and the room already
    owns a machine that says a tone with dots: the Atkinson dither the duplicate
    was drawn with. So this map is that grid read straight -- nothing here is
    thresholded, thinned or thrown from a seed. Error diffusion is exactly what
    puts points along an eyelid and a jawline instead of sprinkling them over the
    bright bits, and the picture's own damage bands come along with it, so the
    sky and the duplicate can never disagree about where the face is.
    Both halves of the bitmap are stars. The ink is the picture's light and the
    paper is its dark, and a sky that goes empty wherever the paint went dark has
    lost the figure -- which is the one thing the constellation is there to
    continue. The paper burns at an eighth of the ink, and the step between them
    is what keeps this a star field and not a projection: how thickly the dither
    scattered its dots still says the tone, and which cells it lit still says
    which stars burn.
    A DataTexture and not a canvas: these are numbers, not colours, so they must
    not be sRGB decoded, premultiplied or filtered on the way in. */
function starMapTexture(cells) {
  const n = cells.cols, m = cells.rows;
  const px = new Uint8Array(n * m * 4);
  for (let i = 0; i < n * m; i++) {
    /* the tone the cell was quantised from, not the bit it became. It barely
       moves the magnitude: one dot, one brightness, is the bitmap's own law, and
       a star that also burns harder where its cell was brighter says the tone
       twice -- which is how the lit passages of the picture came out a sheet. */
    const v = cells.tone[i];
    px[i * 4] = Math.round(Math.min(1, 0.78 + 0.22 * v) * 255);
    /* and only the picture's real lights get a spike. The rest stay points: if
       every cell flared the constellation would be one sheet again. */
    px[i * 4 + 1] = Math.round((v > 0.78 ? 1 : v > 0.55 ? 0.35 : 0.08) * 255);
    px[i * 4 + 2] = Math.round((cells.ink[i] < 0.5 ? 0.12 : 1) * 255);
    px[i * 4 + 3] = 255;
  }
  const t = new THREE.DataTexture(px, n, m, THREE.RGBAFormat, THREE.UnsignedByteType);
  t.colorSpace = THREE.NoColorSpace;
  t.flipY = false;
  t.magFilter = t.minFilter = THREE.NearestFilter;
  t.generateMipmaps = false;
  t.needsUpdate = true;
  return t;
}

/** The sky, hung flat behind the canvas at the picture's own scale, where the
    duplicate used to be. It carries no gallery light and never did: it is the
    only source inside the break, so it is drawn as a plain emissive field -- and
    a field with a star on every third cell is driven by its own aggregate, not
    by any one dot, so the whole constellation has to stay under the bloom
    threshold or the middle of the mouth arrives white. */
function skyMesh(src, e) {
  const o = e.glitch || {};
  const pal = palette(o.hue);
  const tex = starMapTexture(atkinsonCells(src, o.pix || 170, seed(e)));
  /* the same reach as the light quad, so the sky is behind every hole the break
     makes and not only behind the ones inside the frame */
  const c = new THREE.Vector2(o.cx || 0, o.cy || 0);
  const reach = radius(e) * COVER * pad(SKY_Z);
  const W = Math.max(e.w, 2 * (Math.abs(c.x) + reach)) + 0.3;
  const H = Math.max(e.h, 2 * (Math.abs(c.y) + reach)) + 0.3;
  /* The galaxy is anchored on the wound and scaled to it. The sky's coordinates
     run in picture units and the strike reaches nearly four times past the
     canvas, so a fixed zoom is a different galaxy in every work: hung on the
     Starry Night's measurements it showed a coin of light in the middle of a
     five-metre rip, and hung tighter it filled the same rip with one flat
     saturated bulge. What has to be constant is where the spiral's arm band
     falls inside the mouth. The body of the strike is a little under a third of
     its own radius across and the lit part of a log spiral is its first turn or
     two, so the zoom is set to put that turn across the body and let the far
     pockets run out into black. */
  const gz = o.gz === undefined ? radius(e) / e.h * 0.23 : o.gz;
  const gc = new THREE.Vector2(
    c.x / e.w + (o.gcX === undefined ? 0.10 : o.gcX),
    -c.y / e.h + (o.gcY === undefined ? -0.05 : o.gcY));
  const mat = new THREE.ShaderMaterial({
    vertexShader: SKY_VERT,
    fragmentShader: SKY_FRAG,
    uniforms: {
      /* the sky has to know where the breaks are to hide from everywhere else */
      uTearM: uniforms.uTearM,
      uTearP: uniforms.uTearP,
      uTearC: uniforms.uTearC,
      uTearCount: uniforms.uTearCount,
      uCut: uniforms.uCut,
      uStar: { value: tex },
      uGrid: { value: new THREE.Vector2(tex.image.width, tex.image.height) },
      uPlane: { value: new THREE.Vector2(W, H) },
      uPic: { value: new THREE.Vector2(e.w, e.h) },
      uAspect: { value: e.w / e.h },
      uSeed: { value: seed(e) },
      uTint: { value: v3(pal.tint) },
      uBleed: { value: v3(pal.bleed) },
      uGain: { value: 1 },
      uRoll: { value: 0 },
      uRollSeed: { value: 0 },
      /* a band is a dozen cells tall, so a rolled band is a visible tear in the
         sky rather than a one-row shimmer nobody can resolve */
      uRollBands: { value: Math.max(3, Math.round(tex.image.height / 12)) },
      uGc: { value: gc },
      uGz: { value: gz },
      uRot: { value: o.rot === undefined ? 0.42 : o.rot },
      uArms: { value: o.arms === undefined ? 2 : o.arms },
      uTwist: { value: o.twist === undefined ? 2.4 : o.twist },
      uArmGain: { value: o.armGain === undefined ? 1.95 : o.armGain },
      /* The whole constellation has to sit under the bloom threshold, and that is
         a much lower ceiling than it sounds: the dither lights a third of the
         grid, so where the picture was bright every pixel is inside a star, and
         the field's own peak is what crosses. At the old 1.15 the middle of the
         mouth rendered white at 4K and the work's hue was gone from the one place
         it was supposed to be brightest. */
      uStarGain: { value: o.starGain === undefined ? 0.45 : o.starGain }
    }
  });
  const m = new THREE.Mesh(new THREE.PlaneGeometry(W, H), mat);
  /* Behind every surface the break is cut in, and ahead of the black floor of
     the void. The mouth is cut by the eye's ray, so a hole is wider the deeper
     its surface sits -- see tearProj -- and the sky has to be deeper than all of
     them or its own silhouette overpaints a lip of sound wall around the edge
     of the hole and the room grows a green fringe. Twenty five centimetres puts
     it behind the side plaster and the end wall's face alike, and in front of
     the void plate at fifty, or eighty five where the end wall keeps its own. */
  m.position.z = SKY_Z;
  e._ghost = mat;
  return m;
}
/* ------------------------------------------------------------- the void */

function voidMesh(e, z) {
  const g = e.glitch || {};
  /* the floor of the void has to run at least as far as the break does, or a
     long shard cuts the wall and finds the room's other side behind it */
  const reach = radius(e) * COVER * pad(z) +
                Math.max(Math.abs(g.cx || 0), Math.abs(g.cy || 0));
  const m = new THREE.Mesh(
    new THREE.PlaneGeometry(Math.max(e.w + 3.2, 2 * reach), Math.max(e.h + 3.2, 2 * reach)),
    new THREE.MeshBasicMaterial({ color: 0x000000 }));
  m.position.z = z;
  return m;
}

/** Everything the break needs, hung on one picture's group. */
function build(group, e, srcCanvas, opts) {
  group.add(voidMesh(e, (opts && opts.voidZ) || -0.5));
  if (srcCanvas) group.add(skyMesh(srcCanvas, e));
}

const rnd = n => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };

/* Seconds between re-cuts. The break changes on this beat and on nothing else:
   no idle stretch, no frenzy, one steady corruption rate.
   The rate is set by the wall label, not by the effect. The note beside each
   picture is around forty words, which is a quarter of a minute of reading,
   and movement at the edge of a page is what drags the eye off it — so the
   break gets to speak four or five times across a read and no more. For
   reference the web convention is `animation: glitch .3s infinite steps(2)`,
   3.3 changes a second, which is also WCAG 2.3.1's ceiling of three flashes in
   any one-second period; that suits a headline for two seconds, not a room you
   stand in. */
const STEP = 4;
/* however slow the beat, the light's answer to a cut stays a snap */
const POP = 0.12;
/* A flinch is a spasm, not a movement: about six frames long, and inside those
   six frames the level changes only at whole-frame boundaries. */
const FLINCH = 0.10;
const FLINCH_FRAME = 0.034;

/** Where the flinch is, and how hard. Thrown from the beat's own number, so a
    break twitches none, once or twice in a four-second window and always at a
    point that was fixed when the beat started.
    Returns a position spasm, never a brightness one: `roll` is how many cells
    the screen's bands get dragged, `on` is whether the light and the duplicate
    exist at all this frame, and `j` widens the chromatic split. All of it is
    snapped to whole frames -- the point is that it ticks. */
function flinch(t, i, frozen) {
  if (frozen) return { on: 1, roll: 0, j: 0, sd: 0 };
  const step = Math.floor(t / STEP), into = t - step * STEP;
  const throwRoll = rnd(step * 3.1 + i * 7.7);
  const n = throwRoll < 0.34 ? 0 : throwRoll < 0.78 ? 1 : 2;
  for (let k = 0; k < n; k++) {
    const at = STEP * (0.36 + 0.27 * k) +
               (rnd(step * 11.3 + k * 5.9 + i * 1.7) - 0.5) * 0.5;
    if (into < at || into >= at + FLINCH) continue;
    const frame = Math.min(3, Math.floor((into - at) / FLINCH_FRAME));
    const q = rnd(step * 17.1 + k * 3.7 + frame * 1.3 + i * 2.9);
    return {
      /* one frame in five loses the picture outright, which is a harder cut
         than any dimming and cannot blind anyone */
      on: q < 0.20 ? 0 : 1,
      roll: [0, 1, 3, 6][Math.floor(rnd(q * 91.3) * 4)],
      j: [0, 3, 7][Math.floor(rnd(q * 57.1) * 3)],
      sd: 1 + Math.floor(q * 89)
    };
  }
  return { on: 1, roll: 0, j: 0, sd: 0 };
}

/** One frame of the corruption. `frozen` holds the room at its rest shape, for
    reduced-motion users and for stills. */
function tick(t, frozen) {
  const step = frozen ? 0 : Math.floor(t / STEP);
  const into = frozen ? POP : (t % STEP);
  const pop = Math.max(0, 1 - into / POP);
  const r = rnd(step * 91.7);
  /* a cut marks itself with a short, mild lift, not a flash: the light is
     already the brightest thing in the room at rest, and the old 2.3x peak on
     top of it is what the user meant by blinding */
  const gain = 1 + pop * (0.06 + 0.20 * r);
  const jit = pop * 0.8 * (r - 0.5);
  /* The seven edge states a break walks between, in a fixed order, so a tear
     frays through the same sequence and returns rather than being thrown anew
     each beat. This is the whole of what a cut changes now. */
  uniforms.uCut.value = frozen ? 0 : step % 7;
  for (let i = 0; i < base.length; i++) {
    const b = base[i], P = uniforms.uTearP.value[i], C = uniforms.uTearC.value[i];
    if (frozen) {
      P.set(b.r, b.sd); C.set(b.cx, b.cy);
    } else {
      /* the radius only ever shrinks, so the void plate and the light quad
         behind it can never be found short */
      P.set(b.r * (0.90 + 0.10 * rnd(step * 5.3 + i * 17.9)), b.sd);
      /* and the break works along its own axis. Four positions out and four
         back over eight beats, always on the bearing the tear was torn in --
         which is what a rip does under tension, and the opposite of the old
         ±7 cm throw in a random direction that made every cut look like a new
         tear arriving at a new angle. The amplitude is arithmetic, not taste:
         a stroke reaches 3.65 R from the field's centre and COVER is 3.85, so
         the walk plus its cross-play has to stay inside that tenth. */
      const cyc = step % 8;
      const k = ((cyc < 4 ? cyc : 7 - cyc) - 1.5) / 1.5;
      const run = b.r * 0.10 * k;
      const play = (rnd(step * 9.1 + i * 5.1) - 0.5) * 0.02;
      const ca = Math.cos(b.th), sa = Math.sin(b.th);
      C.set(b.cx + ca * run - sa * play, b.cy + sa * run + ca * play);
    }
    /* the flinch rides on top of the cut: the silhouette is still only allowed
       to change on the beat, so a spasm moves the light and the ghost, never
       the edge of the absence itself */
    const f = flinch(t, i, frozen);
    /* the edge light rides on the same numbers the hole was cut with, so there
       is nothing to keep in step: how bright it burns and how far it wobbles is
       all this frame carries */
    uniforms.uLit.value[i].set(gain * f.on, jit + f.j * 0.05);
    const gh = ghosts[i] && ghosts[i].uniforms;
    if (gh) {
      gh.uGain.value = f.on;
      gh.uRoll.value = f.roll;
      gh.uRollSeed.value = f.sd;
    }
  }
}

/* palette is exposed for tools/fringe.js, which previews the tinted plate and
   must not keep its own copy of the colour maths */
window.Glitch = { register, patch, build, bitmapTexture, atkinsonCells, palette,
  tick, uniforms };

})();
